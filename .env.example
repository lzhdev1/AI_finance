# ============================================================
# 数据库（shared-db 网络中的共享 PostgreSQL）
# ============================================================
POSTGRES_DB=quantlab
POSTGRES_USER=quantlab
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# 应用容器内部通过 compose 注入 PGHOST=shared-postgres；
# 在宿主机上直接用 psql / 脚本连库时，把 PGHOST 设为 localhost 即可。

# ============================================================
# LLM（OpenAI 兼容接口）—— 研究经理用 DEEP，未指定时回退 FAST
# ============================================================
# 可选：deepseek | qwen | aliyun | doubao | openai_compatible
LLM_PROVIDER=deepseek
LLM_API_KEY=
# DeepSeek:  https://api.deepseek.com
# Qwen:      https://dashscope.aliyuncs.com/compatible-mode/v1
# 百炼专有部署（形如）: https://ws-xxxx.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# Doubao:    https://ark.cn-beijing.volces.com/api/v3
LLM_BASE_URL=https://api.deepseek.com
# 模型名必须与 /v1/models 返回的 id 完全一致（大小写、点号都不能差）
LLM_MODEL_FAST=deepseek-chat
LLM_MODEL_DEEP=deepseek-reasoner
LLM_TEMPERATURE=0.2
# 推理型模型会先消耗推理 token，给小了会拿到空回复
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120
LLM_JSON_MODE=true
# 作品集展示真实用量与运行费用。默认只在本机工作台开放。
QUANTLAB_PUBLIC_USAGE=0
# 可选，按服务域名、模型、币种设置每百万 token 的合同单价。
# LLM_USAGE_PRICE_JSON={"模型精确ID":{"host":"供应商API域名","currency":"CNY","input":2,"cached_input":0.04,"output":8}}
# 旧版叙述层开关。经理研究的开关位于 backend/configs/settings.yaml 的 llm.enabled。
LLM_NARRATIVE=1

# ============================================================
# 数据源
# ============================================================
# cls=财联社电报, eastmoney=东方财富
NEWS_SOURCES=cls,eastmoney
# 可选，部分指数/宏观数据用
TUSHARE_TOKEN=

# ============================================================
# 基础设施
# ============================================================
# 仅可选 Jupyter 服务使用；留空时由 Jupyter 自动生成。
JUPYTER_TOKEN=
# 国内构建建议用清华源
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# ------------------------------------------------------------
# 说明：策略与 agent 的可调参数（仓数上限、单仓资金、考核期、
# 止损线、板块重合度等）统一放在 configs/settings.yaml，便于版本管理，
# 不再用环境变量。
# ------------------------------------------------------------
